# ==========================================================
# Delivery Tracking System Environment Configuration
# ==========================================================

# Port for the FastAPI web server
PORT=8000

# Public project demo: simulated drivers run without Redis or Kafka.
# Set to false to run the full Kafka -> Redis streaming pipeline.
DEMO_MODE=true

# ----------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------
# Preferred option for managed services like Upstash / Redis Cloud:
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-cluster.upstash.io:6379
REDIS_URL=

# Alternative: local or custom Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ----------------------------------------------------------
# KAFKA CONFIGURATION
# ----------------------------------------------------------
# Local Docker Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security protocol:
# - PLAINTEXT for local Docker
# - SASL_SSL for Upstash / Confluent Cloud
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL mechanism, when using SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka topic and consumer group settings
KAFKA_TOPIC=driver-locations
KAFKA_GROUP_ID=location-writer

# Simulation settings
NUM_DRIVERS=20
HEARTBEAT_TTL_SEC=15
