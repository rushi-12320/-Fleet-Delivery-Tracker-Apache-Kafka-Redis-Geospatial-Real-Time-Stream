# ==========================================================
# Delivery Tracking System Environment Configuration
# ==========================================================

# Port for FastAPI web server (Render/Heroku/Koyeb inject PORT automatically)
PORT=8000

# ----------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------
# Option A: Full Connection URL (preferred for Upstash or Redis Cloud)
# e.g., rediss://default:YOUR_PASSWORD@your-cluster.upstash.io:6379
REDIS_URL=

# Option B: Individual host/port/password (used if REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ----------------------------------------------------------
# KAFKA CONFIGURATION
# ----------------------------------------------------------
# Bootstrap servers (comma-separated if multiple)
# Local: localhost:9092
# Upstash: your-cluster.upstash.io:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security Protocol:
# Local Docker: PLAINTEXT
# Upstash / Confluent Cloud: SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL Mechanism:
# Upstash: SCRAM-SHA-256 or SCRAM-SHA-512
# Confluent Cloud: PLAIN
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# SASL Credentials (leave blank for local PLAINTEXT)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka Topic Name
KAFKA_TOPIC=driver-locations

# Kafka Consumer Group ID
KAFKA_GROUP_ID=location-writer

# Driver Simulation Count
NUM_DRIVERS=20
